{
  "name": "gs-config-template",
  "version": "1.0.0",
  "description": "Reusable Google Sheets config template: EF Core-style migrations, typed sheet schemas, plugin system, health dashboard.",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "lint": "biome check src/ test/ scripts/",
    "lint:fix": "biome check --write src/ test/ scripts/",
    "format": "biome format --write src/ test/ scripts/",
    "test": "jest",
    "test:ci": "jest --ci",
    "build": "node scripts/build.js",
    "ci": "pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/test/**/*.test.js"],
    "setupFiles": ["./test/__mocks__/SpreadsheetApp.js"]
  }
}
