{
  "name": "gs-config-template",
  "version": "0.1.0",
  "description": "Google Apps Script template for Google Sheets config: EF Core-style migrations, typed sheet schemas, plugin system, health dashboard.",
  "license": "MIT",
  "author": "Denis Cuciuc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deniscuciuc/gs-config-template.git"
  },
  "bugs": {
    "url": "https://github.com/deniscuciuc/gs-config-template/issues"
  },
  "homepage": "https://github.com/deniscuciuc/gs-config-template#readme",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "lint": "biome check src/ examples/ test/ scripts/",
    "lint:fix": "biome check --write src/ examples/ test/ scripts/",
    "lint:ci": "biome ci src/ examples/ test/ scripts/",
    "format": "biome format --write src/ examples/ test/ scripts/",
    "test": "jest",
    "test:ci": "jest --ci",
    "test:coverage": "jest --coverage",
    "build": "node scripts/build.js",
    "build:example": "node scripts/build.js --overlay examples/game-config --out dist/bundle.game-config.gs",
    "export:gs": "node scripts/export-gs.js",
    "verify": "pnpm lint:ci && pnpm test:ci && pnpm build && pnpm build:example"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "jest": "^30.5.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "setupFiles": [
      "./test/__mocks__/SpreadsheetApp.js"
    ],
    "collectCoverageFrom": [
      "scripts/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ]
  },
  "pnpm": {
    "overrides": {
      "js-yaml@<3.15.2": ">=3.15.2",
      "brace-expansion@<1.1.16": ">=1.1.16",
      "browserslist@<4.28.7": ">=4.28.7",
      "baseline-browser-mapping@<2.11.0": ">=2.11.0",
      "@babel/core@<7.29.6": ">=7.29.6"
    }
  }
}
