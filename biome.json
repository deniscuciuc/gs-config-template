{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "warn",
        "noRedeclare": "off",
        "noAssignInExpressions": "off"
      },
      "style": {
        "useConst": "error",
        "useSingleVarDeclarator": "warn",
        "noVar": "off"
      },
      "correctness": {
        "noUnusedVariables": "off",
        "noUndeclaredVariables": "off"
      },
      "complexity": {
        "noForEach": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "parser": { "unsafeParameterDecoratorsEnabled": false },
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always"
    },
    "globals": [
      "SpreadsheetApp",
      "Session",
      "Logger",
      "LanguageApp",
      "Utilities",
      "PropertiesService",
      "HtmlService",
      "DriveApp",
      "UrlFetchApp"
    ]
  },
  "files": {
    "include": ["src/**/*.gs", "test/**/*.js", "scripts/**/*.js"],
    "ignore": ["dist/", "node_modules/", "coverage/"]
  },
  "overrides": [
    {
      "include": ["src/**/*.gs"],
      "javascript": {
        "formatter": { "semicolons": "always" }
      },
      "linter": {
        "rules": {
          "style": { "noVar": "off" }
        }
      }
    }
  ]
}
